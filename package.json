{
  "name": "quick-commerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Own-Inventory Quick Commerce Platform for Noida / Delhi NCR",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:api": "pnpm --filter @qc/shared-types build && pnpm --filter @qc/shared-validation build && pnpm --filter @qc/api build",
    "build:web": "pnpm --filter @qc/customer-web build",
    "start:api": "pnpm --filter @qc/api start:prod",
    "start:web": "pnpm --filter @qc/customer-web start",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
